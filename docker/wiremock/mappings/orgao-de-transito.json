{
  "mappings": [
    {
      "name": "órgão de trânsito: grava o gravame",
      "priority": 5,
      "request": {
        "method": "POST",
        "urlPath": "/orgao-de-transito/gravames"
      },
      "response": {
        "status": 202,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "recebido": true
        }
      },
      "serveEventListeners": [
        {
          "name": "webhook",
          "parameters": {
            "method": "POST",
            "url": "{{jsonPath originalRequest.body '$.urlDeRetorno'}}",
            "headers": {
              "Content-Type": "application/json",
              "Authorization": "Bearer {{systemValue type='PROPERTY' key='token.sistema-registro'}}"
            },
            "body": "{\"protocolo\":\"{{jsonPath originalRequest.body '$.protocolo'}}\",\"resultado\":\"REGISTRADO\",\"identificacaoRegistrada\":\"{{jsonPath originalRequest.body '$.identificacaoDoBem'}}\"}",
            "delay": {
              "type": "fixed",
              "milliseconds": 300
            }
          }
        }
      ]
    },
    {
      "name": "órgão de trânsito: recusa na primeira tentativa",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/orgao-de-transito/gravames",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.identificacaoDoBem",
              "contains": "RECUSA"
            }
          },
          {
            "matchesJsonPath": {
              "expression": "$.tentativa",
              "equalTo": "1"
            }
          }
        ]
      },
      "response": {
        "status": 202,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "recebido": true
        }
      },
      "serveEventListeners": [
        {
          "name": "webhook",
          "parameters": {
            "method": "POST",
            "url": "{{jsonPath originalRequest.body '$.urlDeRetorno'}}",
            "headers": {
              "Content-Type": "application/json",
              "Authorization": "Bearer {{systemValue type='PROPERTY' key='token.sistema-registro'}}"
            },
            "body": "{\"protocolo\":\"{{jsonPath originalRequest.body '$.protocolo'}}\",\"resultado\":\"RECUSADO\",\"texto\":\"veículo com restrição\"}",
            "delay": {
              "type": "fixed",
              "milliseconds": 300
            }
          }
        }
      ]
    }
  ]
}